<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BepInEx 6 be.791 IL2CPP hosts plugins on its bundled .NET 6 CoreCLR. -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>PrioritySplitters</AssemblyName>
    <RootNamespace>PrioritySplitters</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <PluginInstallDir>$(GamePath)/BepInEx/plugins/PrioritySplitters</PluginInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GamePath)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/core/Il2CppInterop.Common.dll" Private="false" />
    <!-- Generated by the MoonSweepers BepInEx Patcher on the first launch. -->
    <Reference Include="$(GamePath)/BepInEx/interop/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/interop/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/interop/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/interop/Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/interop/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/interop/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/interop/Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The splitter and merger body meshes split into a cone-less body and the letter cone; built by tools/extract_cone.py. -->
    <EmbeddedResource Include="Resources/splitter-cone.bin" LogicalName="splitter-cone.bin" />
    <EmbeddedResource Include="Resources/merger-cone.bin" LogicalName="merger-cone.bin" />
  </ItemGroup>

  <Target Name="InstallPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' Or '$(InstallPlugin)' == 'true'">
    <MakeDir Directories="$(PluginInstallDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginInstallDir)" />
  </Target>

</Project>
